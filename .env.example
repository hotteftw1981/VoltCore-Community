# VoltCore Community - example environment
# Copy this file to .env and adjust values where needed.

# Optional: override the Community container image used by Portainer.
VOLTCORE_COMMUNITY_IMAGE=ghcr.io/hotteftw1981/voltcore-community:latest

# GitHub Release source for the Community update center.
UPDATE_GITHUB_REPOSITORY=hotteftw1981/VoltCore-Community
UPDATE_CHANNEL=stable

# Host ports.
WEB_HOST_PORT=8010
OCPP_HOST_PORT=9000

# Reverse proxy / cookies.
TRUST_PROXY_HEADERS=0
COOKIE_SECURE=

# FastAPI / API documentation is disabled by default.
ENABLE_API_DOCS=0

# Password hashing baseline.
PBKDF2_ITERATIONS=600000

# Optional OCPP TLS files inside the mounted TLS directory.
OCPP_TLS_CERTFILE=
OCPP_TLS_KEYFILE=

# Optional host directory or named volume for OCPP TLS material.
# Leave empty to use the default named volume.
OCPP_TLS_CERT_DIR=


# Image repository used by one-click update providers.
UPDATE_IMAGE_REPOSITORY=ghcr.io/hotteftw1981/voltcore-community
